# ==============================================================================
# ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# DO NOT place actual credentials, secrets, or API keys in this file.
# This file is committed to version control and must remain safe to share.
# Create a local copy named `.env.local` to store your actual development keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public/Client-side)
# ------------------------------------------------------------------------------
# These variables configure the Firebase Client SDK in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Private/Server-side ONLY)
# ------------------------------------------------------------------------------
# DANGER: NEVER prefix these with NEXT_PUBLIC_.
# These credentials give full administrative access to your Firebase project.
# They must ONLY be used in secure server-side environments (API routes, Node scripts).
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"
